rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== PRIMITIVES ====================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict verified email primitive — required for ALL business operations
    function isVerified() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() >= 3;
    }

    // Zero-lookup primary owner admin check (case-insensitive, strictly requires verified email, safe for allow list)
    function isOwnerAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'xtashtoush@gmail.com';
    }

    // Full admin check for single-document operations (strictly requires verified email)
    function isAdmin() {
      return isOwnerAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Tenant owner MUST have verified email
    function isTenantOwner(tenantId) {
      return isVerified() && request.auth.uid == tenantId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function tenantProjectCount(tenantData) {
      return ('projectCount' in tenantData && tenantData.projectCount is int)
        ? tenantData.projectCount
        : 0;
    }

    // Active access evaluation using authoritative server request.time.
    // Note: pending_payment STILL strictly enforces trial/paid expiry so an expired trial stays locked!
    function hasActiveTenantAccess(tenantData) {
      return tenantData.role == 'admin' ||
        (
          tenantData.subscriptionStatus == 'active' &&
          (tenantData.activeUntil == null || request.time <= tenantData.activeUntil)
        ) ||
        (
          tenantData.subscriptionStatus in ['trialing', 'pending_payment'] &&
          (
            (tenantData.activeUntil != null && request.time <= tenantData.activeUntil) ||
            (
              tenantData.activeUntil == null &&
              tenantData.trialDays is int &&
              tenantData.trialDays > 0 &&
              tenantData.trialDays <= 3650 &&
              request.time <= tenantData.createdAt + duration.value(tenantData.trialDays, 'd')
            )
          )
        );
    }

    // Server-side plan limit enforcement for maxProjects
    function planAllowsNewProject(tenantData) {
      return tenantData.role == 'admin' ||
        (
          tenantData.planId == 'trial' &&
          tenantProjectCount(tenantData) < 25
        ) ||
        (
          exists(/databases/$(database)/documents/plans/$(tenantData.planId)) &&
          (
            get(/databases/$(database)/documents/plans/$(tenantData.planId)).data.maxProjects == -1 ||
            tenantProjectCount(tenantData) < get(/databases/$(database)/documents/plans/$(tenantData.planId)).data.maxProjects
          )
        );
    }

    // Server-side plan limit enforcement for allowCustomTypes
    function planAllowsCustomTypes(tenantData, projectData) {
      return tenantData.role == 'admin' ||
        tenantData.planId == 'trial' ||
        !('utypes' in projectData.snapshot) ||
        !(projectData.snapshot.utypes is list) ||
        projectData.snapshot.utypes.size() == 0 ||
        (
          exists(/databases/$(database)/documents/plans/$(tenantData.planId)) &&
          get(/databases/$(database)/documents/plans/$(tenantData.planId)).data.allowCustomTypes == true
        );
    }

    // ==================== VALIDATION BLUEPRINTS ====================
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        isValidString(data.email, 3, 200) &&
        data.createdAt is timestamp;
    }

    // Public non-sensitive config ONLY (no expiryWebhookUrl or private notification fields)
    function isValidPlatformConfig(data) {
      return data.keys().hasAll([
          'whatsappPhone', 'cliqAlias', 'cliqBankName', 'cliqHolderName',
          'trialDaysDefault', 'supportNote', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'whatsappPhone', 'cliqAlias', 'cliqBankName', 'cliqHolderName',
          'trialDaysDefault', 'supportNote', 'updatedBy', 'updatedAt'
        ]) &&
        isValidString(data.whatsappPhone, 5, 30) &&
        isValidString(data.cliqAlias, 0, 100) &&
        isValidString(data.cliqBankName, 0, 100) &&
        isValidString(data.cliqHolderName, 0, 120) &&
        data.trialDaysDefault is int && data.trialDaysDefault >= 0 && data.trialDaysDefault <= 90 &&
        isValidString(data.supportNote, 0, 500) &&
        isValidId(data.updatedBy) &&
        data.updatedAt is timestamp;
    }

    // Private admin-only notification configuration
    function isValidPrivateNotificationConfig(data) {
      return data.keys().hasAll([
          'adminAlertEmail', 'notificationsEnabled', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'adminAlertEmail', 'notificationsEnabled', 'updatedBy', 'updatedAt'
        ]) &&
        isValidString(data.adminAlertEmail, 3, 200) &&
        data.notificationsEnabled is bool &&
        isValidId(data.updatedBy) &&
        data.updatedAt is timestamp;
    }

    function isValidPlan(data) {
      return data.keys().hasAll([
          'id', 'name', 'priceLabel', 'priceMonthlyJod', 'maxProjects',
          'allowExport', 'allowCustomTypes', 'active', 'sortOrder', 'features', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'priceLabel', 'priceMonthlyJod', 'maxProjects',
          'allowExport', 'allowCustomTypes', 'active', 'sortOrder', 'features', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id.size() <= 40 &&
        isValidString(data.name, 1, 80) &&
        isValidString(data.priceLabel, 1, 60) &&
        (data.priceMonthlyJod is int || data.priceMonthlyJod is float) &&
        data.priceMonthlyJod >= 0 && data.priceMonthlyJod <= 10000 &&
        data.maxProjects is int && data.maxProjects >= -1 && data.maxProjects <= 100000 &&
        data.allowExport is bool &&
        data.allowCustomTypes is bool &&
        data.active is bool &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100 &&
        data.features is list && data.features.size() <= 12 &&
        (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 140)) &&
        data.updatedAt is timestamp;
    }

    function isValidTenant(data, expectedUid) {
      return data.keys().hasAll([
          'ownerUid', 'email', 'displayName', 'workshopName', 'phone',
          'role', 'subscriptionStatus', 'planId', 'trialDays',
          'activeUntil', 'adminNote', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'email', 'displayName', 'workshopName', 'phone',
          'role', 'subscriptionStatus', 'planId', 'trialDays',
          'activeUntil', 'adminNote', 'projectCount', 'lastProjectActionId',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == expectedUid &&
        isValidString(data.email, 3, 200) &&
        isValidString(data.displayName, 0, 120) &&
        isValidString(data.workshopName, 0, 120) &&
        isValidString(data.phone, 0, 30) &&
        data.role in ['owner', 'admin'] &&
        data.subscriptionStatus in ['trialing', 'pending_payment', 'active', 'expired', 'suspended'] &&
        isValidId(data.planId) && data.planId.size() <= 40 &&
        data.trialDays is int && data.trialDays >= 0 && data.trialDays <= 3650 &&
        (data.activeUntil == null || data.activeUntil is timestamp) &&
        isValidString(data.adminNote, 0, 500) &&
        (!('projectCount' in data) || (data.projectCount is int && data.projectCount >= 0 && data.projectCount <= 100000)) &&
        (!('lastProjectActionId' in data) || isValidString(data.lastProjectActionId, 0, 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProject(data, tenantId) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'windowType', 'unit', 'windowCount',
          'snapshot', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'name', 'windowType', 'unit', 'windowCount',
          'snapshot', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == tenantId &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.windowType, 1, 100) &&
        data.unit in ['m', 'cm', 'mm'] &&
        data.windowCount is int && data.windowCount >= 0 && data.windowCount <= 1000 &&
        data.snapshot is map && data.snapshot.keys().size() <= 30 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidActivationRequest(data) {
      return data.keys().hasAll([
          'tenantId', 'ownerUid', 'email', 'workshopName', 'phone',
          'planId', 'billingCycle', 'cliqNote', 'status', 'reviewedBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'tenantId', 'ownerUid', 'email', 'workshopName', 'phone',
          'planId', 'billingCycle', 'cliqNote', 'status', 'reviewedBy',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.tenantId) &&
        isValidId(data.ownerUid) &&
        data.tenantId == data.ownerUid &&
        isValidString(data.email, 3, 200) &&
        isValidString(data.workshopName, 1, 120) &&
        isValidString(data.phone, 0, 30) &&
        isValidId(data.planId) && data.planId.size() <= 40 &&
        data.billingCycle in ['monthly', 'quarterly', 'yearly'] &&
        isValidString(data.cliqNote, 0, 300) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isValidString(data.reviewedBy, 0, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'actorUid', 'actorEmail', 'action', 'targetTenantId', 'details', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'actorUid', 'actorEmail', 'action', 'targetTenantId', 'details',
          'beforeState', 'afterState', 'createdAt'
        ]) &&
        isValidId(data.actorUid) &&
        data.actorUid == request.auth.uid &&
        isValidString(data.actorEmail, 3, 200) &&
        isValidString(data.action, 1, 80) &&
        isValidString(data.targetTenantId, 0, 128) &&
        isValidString(data.details, 0, 500) &&
        (!('beforeState' in data) || isValidString(data.beforeState, 0, 600)) &&
        (!('afterState' in data) || isValidString(data.afterState, 0, 600)) &&
        data.createdAt is timestamp;
    }

    function isValidExpiryAlert(data) {
      return data.keys().hasAll([
          'tenantId', 'ownerUid', 'email', 'workshopName', 'phone',
          'alertType', 'expiresAt', 'hoursLeft', 'adminEmail',
          'emailStatus', 'acknowledged', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'tenantId', 'ownerUid', 'email', 'workshopName', 'phone',
          'alertType', 'expiresAt', 'hoursLeft', 'adminEmail',
          'emailStatus', 'acknowledged', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.tenantId) &&
        isValidId(data.ownerUid) &&
        data.tenantId == data.ownerUid &&
        isValidString(data.email, 3, 200) &&
        isValidString(data.workshopName, 0, 120) &&
        isValidString(data.phone, 0, 30) &&
        data.alertType in ['trial_expiring', 'subscription_expiring'] &&
        data.expiresAt is timestamp &&
        data.hoursLeft is int && data.hoursLeft >= 0 && data.hoursLeft <= 48 &&
        isValidString(data.adminEmail, 3, 200) &&
        data.emailStatus in ['pending', 'sent', 'manual', 'failed'] &&
        data.acknowledged is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // ==================== CONNECTION PROBE ====================
    match /test/connection {
      allow get: if isSignedIn();
    }

    // ==================== ADMINS (OWNER-MANAGED ONLY) ====================
    match /admins/{adminUid} {
      allow get: if isVerified() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isOwnerAdmin();
      allow create: if isOwnerAdmin() && isValidId(adminUid) && isValidAdminRecord(incoming()) &&
        incoming().uid == adminUid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isOwnerAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    // ==================== PUBLIC PLATFORM CONFIG (CliQ & WhatsApp ONLY) ====================
    match /config/{configId} {
      allow get: if isVerified() && isValidId(configId);
      allow list: if false;
      allow create: if isVerified() && isValidId(configId) &&
        isValidPlatformConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerified() && isValidId(configId) &&
        isValidPlatformConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'whatsappPhone', 'cliqAlias', 'cliqBankName', 'cliqHolderName',
          'trialDaysDefault', 'supportNote', 'adminAlertEmail', 'expiryWebhookUrl',
          'updatedBy', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    // ==================== PRIVATE ADMIN CONFIG (NEVER READABLE BY REGULAR USERS) ====================
    match /config_private/{configId} {
      allow get: if isVerified() && isValidId(configId) && isAdmin();
      allow list: if false;
      allow create: if isVerified() && isValidId(configId) &&
        isValidPrivateNotificationConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerified() && isValidId(configId) &&
        isValidPrivateNotificationConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'adminAlertEmail', 'notificationsEnabled', 'updatedBy', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    // ==================== SUBSCRIPTION PLANS ====================
    match /plans/{planId} {
      allow get: if isVerified() && isValidId(planId);
      allow list: if isVerified() && (resource.data.active == true || isOwnerAdmin());
      allow create: if isVerified() && isValidId(planId) &&
        isValidPlan(incoming()) &&
        incoming().id == planId &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerified() && isValidId(planId) &&
        isValidPlan(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'priceLabel', 'priceMonthlyJod', 'maxProjects',
          'allowExport', 'allowCustomTypes', 'active', 'sortOrder', 'features', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isOwnerAdmin() && isValidId(planId);
    }

    // ==================== TENANTS (VERIFIED EMAIL REQUIRED & SERVER-TIME TRIAL) ====================
    match /tenants/{tenantId} {
      allow get: if isVerified() && isValidId(tenantId) && (isTenantOwner(tenantId) || isAdmin());
      allow list: if isOwnerAdmin();

      // Self-registration: strictly requires verified email + server request.time + 7-day trial
      allow create: if isVerified() && isValidId(tenantId) &&
        isValidTenant(incoming(), tenantId) &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        tenantProjectCount(incoming()) == 0 &&
        (
          (
            isAdmin() &&
            incoming().ownerUid == request.auth.uid &&
            incoming().role == 'admin' &&
            incoming().subscriptionStatus == 'active' &&
            incoming().planId == 'owner_free' &&
            incoming().activeUntil == null
          ) ||
          (
            isTenantOwner(tenantId) &&
            incoming().role == 'owner' &&
            incoming().subscriptionStatus == 'trialing' &&
            incoming().planId == 'trial' &&
            incoming().trialDays == 7 &&
            incoming().activeUntil == null &&
            incoming().adminNote == ''
          )
        );

      // Action-Based Update: Admin vs Tenant Profile vs Pending Payment Transition vs Atomic Project Counter
      allow update: if isVerified() && isValidId(tenantId) &&
        isValidTenant(incoming(), existing().ownerUid) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopName', 'phone', 'displayName', 'subscriptionStatus',
              'planId', 'trialDays', 'activeUntil', 'adminNote', 'role',
              'projectCount', 'lastProjectActionId', 'updatedAt'
            ])
          ) ||
          (
            // Tenant profile fields only
            isTenantOwner(tenantId) &&
            incoming().role == existing().role &&
            incoming().subscriptionStatus == existing().subscriptionStatus &&
            incoming().planId == existing().planId &&
            incoming().trialDays == existing().trialDays &&
            incoming().activeUntil == existing().activeUntil &&
            incoming().adminNote == existing().adminNote &&
            tenantProjectCount(incoming()) == tenantProjectCount(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopName', 'phone', 'displayName', 'updatedAt'
            ])
          ) ||
          (
            // Tenant submitting CliQ payment request: only trialing/expired -> pending_payment (never grants access!)
            isTenantOwner(tenantId) &&
            existing().subscriptionStatus in ['trialing', 'expired'] &&
            incoming().subscriptionStatus == 'pending_payment' &&
            incoming().role == existing().role &&
            incoming().planId == existing().planId &&
            incoming().trialDays == existing().trialDays &&
            incoming().activeUntil == existing().activeUntil &&
            incoming().adminNote == existing().adminNote &&
            tenantProjectCount(incoming()) == tenantProjectCount(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'subscriptionStatus', 'updatedAt'
            ])
          ) ||
          (
            // Atomic +1 projectCount increment coupled to creating a new project document in the same transaction
            isTenantOwner(tenantId) &&
            hasActiveTenantAccess(existing()) &&
            planAllowsNewProject(existing()) &&
            incoming().role == existing().role &&
            incoming().subscriptionStatus == existing().subscriptionStatus &&
            incoming().planId == existing().planId &&
            incoming().trialDays == existing().trialDays &&
            incoming().activeUntil == existing().activeUntil &&
            incoming().adminNote == existing().adminNote &&
            incoming().projectCount == tenantProjectCount(existing()) + 1 &&
            isValidId(incoming().lastProjectActionId) &&
            !exists(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(incoming().lastProjectActionId)) &&
            existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(incoming().lastProjectActionId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'projectCount', 'lastProjectActionId', 'updatedAt'
            ])
          ) ||
          (
            // Atomic -1 projectCount decrement coupled to deleting an existing project document in the same transaction
            isTenantOwner(tenantId) &&
            hasActiveTenantAccess(existing()) &&
            tenantProjectCount(existing()) > 0 &&
            incoming().role == existing().role &&
            incoming().subscriptionStatus == existing().subscriptionStatus &&
            incoming().planId == existing().planId &&
            incoming().trialDays == existing().trialDays &&
            incoming().activeUntil == existing().activeUntil &&
            incoming().adminNote == existing().adminNote &&
            incoming().projectCount == tenantProjectCount(existing()) - 1 &&
            isValidId(incoming().lastProjectActionId) &&
            exists(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(incoming().lastProjectActionId)) &&
            !existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(incoming().lastProjectActionId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'projectCount', 'lastProjectActionId', 'updatedAt'
            ])
          )
        );

      allow delete: if isOwnerAdmin() && isValidId(tenantId);

      // ==================== TENANT PROJECTS (MASTER GATE + SERVER PLAN LIMITS) ====================
      match /projects/{projectId} {
        allow get: if isVerified() && isValidId(tenantId) && isValidId(projectId) &&
          (
            isAdmin() ||
            (
              isTenantOwner(tenantId) &&
              exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
              hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data)
            )
          );

        allow list: if isVerified() && (
          (
            request.auth.uid == tenantId &&
            resource.data.ownerUid == request.auth.uid &&
            exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
            hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data)
          ) ||
          isOwnerAdmin()
        );

        // Master Gate: verified email + active subscription/trial + maxProjects + allowCustomTypes + atomic projectCount increment
        allow create: if isVerified() && isValidId(tenantId) && isValidId(projectId) &&
          isValidProject(incoming(), tenantId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              isTenantOwner(tenantId) &&
              exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
              hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data) &&
              planAllowsNewProject(get(/databases/$(database)/documents/tenants/$(tenantId)).data) &&
              planAllowsCustomTypes(get(/databases/$(database)/documents/tenants/$(tenantId)).data, incoming()) &&
              getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.projectCount ==
                tenantProjectCount(get(/databases/$(database)/documents/tenants/$(tenantId)).data) + 1
            )
          );

        allow update: if isVerified() && isValidId(tenantId) && isValidId(projectId) &&
          isValidProject(incoming(), existing().ownerUid) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'windowType', 'unit', 'windowCount', 'snapshot', 'updatedAt'
          ]) &&
          (
            isAdmin() ||
            (
              isTenantOwner(tenantId) &&
              exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
              hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data) &&
              planAllowsCustomTypes(get(/databases/$(database)/documents/tenants/$(tenantId)).data, incoming())
            )
          );

        allow delete: if isVerified() && isValidId(tenantId) && isValidId(projectId) &&
          (
            isAdmin() ||
            (
              isTenantOwner(tenantId) &&
              exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
              hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data) &&
              (
                tenantProjectCount(get(/databases/$(database)/documents/tenants/$(tenantId)).data) == 0 ||
                getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.projectCount ==
                  tenantProjectCount(get(/databases/$(database)/documents/tenants/$(tenantId)).data) - 1
              )
            )
          );
      }
    }

    // ==================== ACTIVATION REQUESTS (CliQ / WhatsApp — NO DOUBLE APPROVAL) ====================
    match /activation_requests/{requestId} {
      allow get: if isVerified() && isValidId(requestId) &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow list: if isVerified() && (
        resource.data.ownerUid == request.auth.uid || isOwnerAdmin()
      );

      // Allowed even when trial/subscription is expired so locked users can submit CliQ payment requests!
      allow create: if isVerified() && isValidId(requestId) &&
        isValidActivationRequest(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().tenantId == request.auth.uid &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().status == 'pending' &&
        incoming().reviewedBy == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/tenants/$(request.auth.uid));

      // Terminal State Locking: Admin can ONLY approve/reject a 'pending' request (prevents double-approval!)
      allow update: if isVerified() && isValidId(requestId) &&
        isValidActivationRequest(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().tenantId == existing().tenantId &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            existing().status == 'pending' &&
            incoming().status in ['approved', 'rejected'] &&
            incoming().reviewedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt'])
          ) ||
          (
            existing().ownerUid == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().reviewedBy == existing().reviewedBy &&
            incoming().diff(existing()).affectedKeys().hasOnly(['cliqNote', 'phone', 'planId', 'billingCycle', 'updatedAt'])
          )
        );

      allow delete: if isOwnerAdmin() && isValidId(requestId);
    }

    // ==================== EXPIRY ALERTS (< 2 DAYS) ====================
    match /expiry_alerts/{alertId} {
      allow get: if isVerified() && isValidId(alertId) &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow list: if isVerified() && (
        resource.data.ownerUid == request.auth.uid || isOwnerAdmin()
      );

      allow create: if isVerified() && isValidId(alertId) &&
        isValidExpiryAlert(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().tenantId == request.auth.uid &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().acknowledged == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/tenants/$(request.auth.uid));

      allow update: if isVerified() && isValidId(alertId) &&
        isValidExpiryAlert(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().tenantId == existing().tenantId &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['acknowledged', 'emailStatus', 'updatedAt'])
          ) ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().acknowledged == existing().acknowledged &&
            incoming().diff(existing()).affectedKeys().hasOnly(['emailStatus', 'hoursLeft', 'updatedAt'])
          )
        );

      allow delete: if isOwnerAdmin() && isValidId(alertId);
    }

    // ==================== IMMUTABLE AUDIT LOGS ====================
    match /audit_logs/{logId} {
      allow get: if isVerified() && isValidId(logId) && isAdmin();
      allow list: if isOwnerAdmin();
      allow create: if isVerified() && isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if false;
    }
  }
}
