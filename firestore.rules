rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== PRIMITIVES ====================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict verified email primitive — required for ALL business operations
    function isVerified() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() >= 3;
    }

    // Zero-lookup primary owner admin check (case-insensitive, strictly requires verified email)
    function isOwnerAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'xtashtoush@gmail.com';
    }

    // Spark-safe launch: all administrative actions are strictly locked to the verified primary owner
    function isAdmin() {
      return isOwnerAdmin();
    }

    // Tenant owner MUST have verified email
    function isTenantOwner(tenantId) {
      return isVerified() && request.auth.uid == tenantId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function tenantProjectCount(tenantData) {
      return ('projectCount' in tenantData && tenantData.projectCount is int)
        ? tenantData.projectCount
        : 0;
    }

    function isValidSubscriptionDays(d) {
      return d is int && d in [30, 90, 365];
    }

    function hasServerTimedSubscription(tenantData) {
      return 'activatedAt' in tenantData &&
        tenantData.activatedAt is timestamp &&
        'subscriptionDays' in tenantData &&
        isValidSubscriptionDays(tenantData.subscriptionDays);
    }

    function activatedAtUnchanged(inc, ex) {
      return (!('activatedAt' in inc) && !('activatedAt' in ex)) ||
        ('activatedAt' in inc && 'activatedAt' in ex && inc.activatedAt == ex.activatedAt);
    }

    function subscriptionDaysUnchanged(inc, ex) {
      return (!('subscriptionDays' in inc) && !('subscriptionDays' in ex)) ||
        ('subscriptionDays' in inc && 'subscriptionDays' in ex && inc.subscriptionDays == ex.subscriptionDays);
    }

    // Paid subscription validity using authoritative server request.time.
    // Server-timed accounts (activatedAt + subscriptionDays) STRICTLY ignore legacy activeUntil.
    // Legacy accounts without activatedAt/subscriptionDays remain compatible via activeUntil.
    function hasValidPaidSubscription(tenantData) {
      return tenantData.planId != 'trial' && (
        hasServerTimedSubscription(tenantData)
          ? request.time <= tenantData.activatedAt + duration.value(tenantData.subscriptionDays, 'd')
          : (
              !('activatedAt' in tenantData) &&
              !('subscriptionDays' in tenantData) &&
              (tenantData.activeUntil == null || request.time <= tenantData.activeUntil)
            )
      );
    }

    // Active access evaluation using authoritative server request.time.
    // pending_payment STILL strictly enforces trial/paid expiry so an expired trial stays locked!
    function hasActiveTenantAccess(tenantData) {
      return (tenantData.role == 'admin' && isOwnerAdmin()) ||
        (
          tenantData.subscriptionStatus == 'active' &&
          hasValidPaidSubscription(tenantData)
        ) ||
        (
          tenantData.subscriptionStatus in ['trialing', 'pending_payment'] &&
          (
            (
              hasServerTimedSubscription(tenantData) &&
              request.time <= tenantData.activatedAt + duration.value(tenantData.subscriptionDays, 'd')
            ) ||
            (
              !('activatedAt' in tenantData) &&
              !('subscriptionDays' in tenantData) &&
              tenantData.activeUntil != null &&
              request.time <= tenantData.activeUntil
            ) ||
            (
              !('activatedAt' in tenantData) &&
              !('subscriptionDays' in tenantData) &&
              tenantData.activeUntil == null &&
              tenantData.trialDays is int &&
              tenantData.trialDays > 0 &&
              tenantData.trialDays <= 3650 &&
              request.time <= tenantData.createdAt + duration.value(tenantData.trialDays, 'd')
            )
          )
        );
    }

    // Server-side plan limit enforcement for maxProjects
    function planAllowsNewProject(tenantData) {
      return (tenantData.role == 'admin' && isOwnerAdmin()) ||
        (
          tenantData.planId == 'trial' &&
          tenantProjectCount(tenantData) < 25
        ) ||
        (
          exists(/databases/$(database)/documents/plans/$(tenantData.planId)) &&
          (
            get(/databases/$(database)/documents/plans/$(tenantData.planId)).data.maxProjects == -1 ||
            tenantProjectCount(tenantData) < get(/databases/$(database)/documents/plans/$(tenantData.planId)).data.maxProjects
          )
        );
    }

    function tenantExtraTypesQuota(tenantData) {
      return ('extraCustomTypesQuota' in tenantData &&
        tenantData.extraCustomTypesQuota is int &&
        tenantData.extraCustomTypesQuota > 0)
        ? tenantData.extraCustomTypesQuota
        : 0;
    }

    function planBaseMaxCustomTypes(planData) {
      return ('maxCustomTypes' in planData && planData.maxCustomTypes is int)
        ? planData.maxCustomTypes
        : (planData.id == 'starter' ? 0 : (planData.id == 'pro' ? 2 : (planData.id == 'business' ? 5 : (planData.allowCustomTypes == true ? 2 : 0))));
    }

    function planMaxCustomFieldsPerType(planData) {
      return ('maxCustomFieldsPerType' in planData && planData.maxCustomFieldsPerType is int)
        ? planData.maxCustomFieldsPerType
        : (planData.id == 'starter' ? 2 : (planData.id == 'pro' ? 5 : (planData.id == 'business' ? -1 : 2)));
    }

    function planAllowsExtraTypesAddon(planData) {
      return ('allowExtraTypesAddon' in planData && planData.allowExtraTypesAddon is bool)
        ? planData.allowExtraTypesAddon
        : (planData.id == 'business');
    }

    function isValidUtypeItemAt(utypes, idx) {
      return utypes.size() <= idx ||
        (
          utypes[idx] is map &&
          'name' in utypes[idx] &&
          isValidString(utypes[idx].name, 1, 100) &&
          utypes[idx].name.trim().size() >= 1
        );
    }

    // Strict structural check: launch cap is strictly 10 custom types; ALL 10 elements (0..9) validated!
    function hasValidUtypesShape(projectData) {
      return !('utypes' in projectData.snapshot) ||
        (
          projectData.snapshot.utypes is list &&
          projectData.snapshot.utypes.size() <= 10 &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 0) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 1) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 2) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 3) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 4) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 5) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 6) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 7) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 8) &&
          isValidUtypeItemAt(projectData.snapshot.utypes, 9)
        );
    }

    // Server-side plan limit enforcement for maxCustomTypes (hard cap <= 10 in free launch stage)
    function planAllowsCustomTypes(tenantData, projectData) {
      return hasValidUtypesShape(projectData) && (
        (tenantData.role == 'admin' && isOwnerAdmin()) ||
        !('utypes' in projectData.snapshot) ||
        projectData.snapshot.utypes.size() == 0 ||
        (
          tenantData.subscriptionStatus == 'active' &&
          tenantData.planId != 'trial' &&
          exists(/databases/$(database)/documents/plans/$(tenantData.planId)) &&
          (
            planBaseMaxCustomTypes(get(/databases/$(database)/documents/plans/$(tenantData.planId)).data) == -1 ||
            projectData.snapshot.utypes.size() <= (
              planBaseMaxCustomTypes(get(/databases/$(database)/documents/plans/$(tenantData.planId)).data) +
              (
                planAllowsExtraTypesAddon(get(/databases/$(database)/documents/plans/$(tenantData.planId)).data)
                  ? tenantExtraTypesQuota(tenantData)
                  : 0
              )
            )
          )
        )
      );
    }

    // Ensure any newly granted extraCustomTypesQuota can NEVER push base + extra above 10
    function adminExtraQuotaWithinCap(tenantData) {
      return tenantExtraTypesQuota(tenantData) == 0 ||
        (
          tenantData.planId != 'trial' &&
          exists(/databases/$(database)/documents/plans/$(tenantData.planId)) &&
          planAllowsExtraTypesAddon(get(/databases/$(database)/documents/plans/$(tenantData.planId)).data) &&
          planBaseMaxCustomTypes(get(/databases/$(database)/documents/plans/$(tenantData.planId)).data) >= 0 &&
          (
            planBaseMaxCustomTypes(get(/databases/$(database)/documents/plans/$(tenantData.planId)).data) +
            tenantExtraTypesQuota(tenantData)
          ) <= 10
        );
    }

    function isValidCustomFieldList(customMap, keyName, maxAllowed) {
      return !(keyName in customMap) ||
        (
          customMap[keyName] is list &&
          (maxAllowed == -1 ? customMap[keyName].size() <= 500 : customMap[keyName].size() <= maxAllowed)
        );
    }

    function utypeNameAt(projectData, idx) {
      return ('utypes' in projectData.snapshot &&
        projectData.snapshot.utypes is list &&
        projectData.snapshot.utypes.size() > idx &&
        projectData.snapshot.utypes[idx] is map &&
        'name' in projectData.snapshot.utypes[idx] &&
        projectData.snapshot.utypes[idx].name is string)
        ? projectData.snapshot.utypes[idx].name
        : 'شباك 3 مجاري نظامي';
    }

    // Exact allowed custom map keys: ONLY the 4 built-in window types + existing utypes (0..9)
    function allowedCustomKeys(projectData) {
      return [
        'شباك 3 مجاري نظامي',
        'شباك 2.5 نظامي',
        'واجهات 2.5 بدون صندوق',
        'شباك 3 مجاري بدون صندوق',
        utypeNameAt(projectData, 0),
        utypeNameAt(projectData, 1),
        utypeNameAt(projectData, 2),
        utypeNameAt(projectData, 3),
        utypeNameAt(projectData, 4),
        utypeNameAt(projectData, 5),
        utypeNameAt(projectData, 6),
        utypeNameAt(projectData, 7),
        utypeNameAt(projectData, 8),
        utypeNameAt(projectData, 9)
      ];
    }

    // Strict structural check: omitted custom == empty map; present non-map, unknown keys, or non-list values MUST be rejected!
    function hasValidCustomMapShape(projectData) {
      return !('custom' in projectData.snapshot) ||
        (
          projectData.snapshot.custom is map &&
          projectData.snapshot.custom.keys().size() <= 14 &&
          projectData.snapshot.custom.keys().hasOnly(allowedCustomKeys(projectData)) &&
          isValidCustomFieldList(projectData.snapshot.custom, 'شباك 3 مجاري نظامي', -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, 'شباك 2.5 نظامي', -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, 'واجهات 2.5 بدون صندوق', -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, 'شباك 3 مجاري بدون صندوق', -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 0), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 1), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 2), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 3), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 4), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 5), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 6), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 7), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 8), -1) &&
          isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 9), -1)
        );
    }

    // Zero-loop, zero-bypass server-side enforcement of maxCustomFieldsPerType across all 4 built-in + up to 10 custom types
    function customFieldsWithinLimit(projectData, maxFields) {
      return hasValidUtypesShape(projectData) &&
        hasValidCustomMapShape(projectData) && (
          !('custom' in projectData.snapshot) ||
          (
            projectData.snapshot.custom.keys().hasOnly(allowedCustomKeys(projectData)) &&
            isValidCustomFieldList(projectData.snapshot.custom, 'شباك 3 مجاري نظامي', maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, 'شباك 2.5 نظامي', maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, 'واجهات 2.5 بدون صندوق', maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, 'شباك 3 مجاري بدون صندوق', maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 0), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 1), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 2), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 3), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 4), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 5), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 6), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 7), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 8), maxFields) &&
            isValidCustomFieldList(projectData.snapshot.custom, utypeNameAt(projectData, 9), maxFields)
          )
        );
    }

    function planAllowsCustomFields(tenantData, projectData) {
      return hasValidUtypesShape(projectData) &&
        hasValidCustomMapShape(projectData) && (
          (tenantData.role == 'admin' && isOwnerAdmin()) ||
          (
            (tenantData.planId == 'trial' || tenantData.subscriptionStatus != 'active') &&
            customFieldsWithinLimit(projectData, 2)
          ) ||
          (
            tenantData.subscriptionStatus == 'active' &&
            tenantData.planId != 'trial' &&
            exists(/databases/$(database)/documents/plans/$(tenantData.planId)) &&
            customFieldsWithinLimit(
              projectData,
              planMaxCustomFieldsPerType(get(/databases/$(database)/documents/plans/$(tenantData.planId)).data)
            )
          )
        );
    }

    // ==================== VALIDATION BLUEPRINTS ====================
    // Public non-sensitive config ONLY (CliQ & WhatsApp — never contains secrets or webhook URLs)
    function isValidPlatformConfig(data) {
      return data.keys().hasAll([
          'whatsappPhone', 'cliqAlias', 'cliqBankName', 'cliqHolderName',
          'trialDaysDefault', 'supportNote', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'whatsappPhone', 'cliqAlias', 'cliqBankName', 'cliqHolderName',
          'trialDaysDefault', 'supportNote', 'updatedBy', 'updatedAt'
        ]) &&
        isValidString(data.whatsappPhone, 5, 30) &&
        isValidString(data.cliqAlias, 0, 100) &&
        isValidString(data.cliqBankName, 0, 100) &&
        isValidString(data.cliqHolderName, 0, 120) &&
        data.trialDaysDefault is int && data.trialDaysDefault == 7 &&
        isValidString(data.supportNote, 0, 500) &&
        isValidId(data.updatedBy) &&
        data.updatedAt is timestamp;
    }

    function isValidPlan(data) {
      return data.keys().hasAll([
          'id', 'name', 'priceLabel', 'priceMonthlyJod', 'maxProjects',
          'allowExport', 'allowCustomTypes', 'active', 'sortOrder', 'features', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'priceLabel', 'priceMonthlyJod', 'maxProjects',
          'allowExport', 'allowCustomTypes', 'maxCustomTypes', 'maxCustomFieldsPerType',
          'allowExtraTypesAddon', 'extraTypesPackSize', 'extraTypesPackPriceJod',
          'active', 'sortOrder', 'features', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id.size() <= 40 &&
        isValidString(data.name, 1, 80) &&
        isValidString(data.priceLabel, 1, 60) &&
        (data.priceMonthlyJod is int || data.priceMonthlyJod is float) &&
        data.priceMonthlyJod >= 0 && data.priceMonthlyJod <= 10000 &&
        data.maxProjects is int && data.maxProjects >= -1 && data.maxProjects <= 100000 &&
        data.allowExport is bool &&
        data.allowCustomTypes is bool &&
        (!('maxCustomTypes' in data) || (data.maxCustomTypes is int && data.maxCustomTypes >= -1 && data.maxCustomTypes <= 10)) &&
        (!('maxCustomFieldsPerType' in data) || (data.maxCustomFieldsPerType is int && data.maxCustomFieldsPerType >= -1 && data.maxCustomFieldsPerType <= 500)) &&
        (!('allowExtraTypesAddon' in data) || data.allowExtraTypesAddon is bool) &&
        (!('extraTypesPackSize' in data) || (data.extraTypesPackSize is int && data.extraTypesPackSize >= 0 && data.extraTypesPackSize <= 10)) &&
        (!('extraTypesPackPriceJod' in data) || ((data.extraTypesPackPriceJod is int || data.extraTypesPackPriceJod is float) && data.extraTypesPackPriceJod >= 0 && data.extraTypesPackPriceJod <= 10000)) &&
        data.active is bool &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100 &&
        data.features is list && data.features.size() <= 12 &&
        (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 140)) &&
        data.updatedAt is timestamp;
    }

    function isValidTenant(data, expectedUid) {
      return data.keys().hasAll([
          'ownerUid', 'email', 'displayName', 'workshopName', 'phone',
          'role', 'subscriptionStatus', 'planId', 'trialDays',
          'activeUntil', 'adminNote', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'email', 'displayName', 'workshopName', 'phone',
          'role', 'subscriptionStatus', 'planId', 'trialDays',
          'activatedAt', 'subscriptionDays',
          'activeUntil', 'adminNote', 'projectCount', 'lastProjectActionId',
          'extraCustomTypesQuota', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == expectedUid &&
        isValidString(data.email, 3, 200) &&
        isValidString(data.displayName, 0, 120) &&
        isValidString(data.workshopName, 0, 120) &&
        isValidString(data.phone, 0, 30) &&
        data.role in ['owner', 'admin'] &&
        data.subscriptionStatus in ['trialing', 'pending_payment', 'active', 'expired', 'suspended'] &&
        isValidId(data.planId) && data.planId.size() <= 40 &&
        data.trialDays is int && data.trialDays >= 0 && data.trialDays <= 3650 &&
        (data.activeUntil == null || data.activeUntil is timestamp) &&
        (
          (!('activatedAt' in data) && !('subscriptionDays' in data)) ||
          (
            'activatedAt' in data &&
            data.activatedAt is timestamp &&
            'subscriptionDays' in data &&
            isValidSubscriptionDays(data.subscriptionDays) &&
            data.activeUntil == null
          )
        ) &&
        isValidString(data.adminNote, 0, 500) &&
        (!('projectCount' in data) || (data.projectCount is int && data.projectCount >= 0 && data.projectCount <= 100000)) &&
        (!('lastProjectActionId' in data) || isValidString(data.lastProjectActionId, 0, 128)) &&
        (!('extraCustomTypesQuota' in data) || (data.extraCustomTypesQuota is int && data.extraCustomTypesQuota >= 0 && data.extraCustomTypesQuota <= 200)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProject(data, tenantId) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'windowType', 'unit', 'windowCount',
          'snapshot', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'name', 'windowType', 'unit', 'windowCount',
          'snapshot', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == tenantId &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.windowType, 1, 100) &&
        data.unit in ['m', 'cm', 'mm'] &&
        data.windowCount is int && data.windowCount >= 0 && data.windowCount <= 1000 &&
        data.snapshot is map && data.snapshot.keys().size() <= 30 &&
        hasValidUtypesShape(data) &&
        hasValidCustomMapShape(data) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidActivationRequest(data) {
      return data.keys().hasAll([
          'tenantId', 'ownerUid', 'email', 'workshopName', 'phone',
          'planId', 'billingCycle', 'cliqNote', 'status', 'reviewedBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'tenantId', 'ownerUid', 'email', 'workshopName', 'phone',
          'planId', 'billingCycle', 'cliqNote', 'status', 'reviewedBy',
          'requestType', 'extraTypesCount', 'addonPriceJod',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.tenantId) &&
        isValidId(data.ownerUid) &&
        data.tenantId == data.ownerUid &&
        isValidString(data.email, 3, 200) &&
        isValidString(data.workshopName, 1, 120) &&
        isValidString(data.phone, 0, 30) &&
        isValidId(data.planId) && data.planId.size() <= 40 &&
        data.billingCycle in ['monthly', 'quarterly', 'yearly'] &&
        isValidString(data.cliqNote, 0, 300) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isValidString(data.reviewedBy, 0, 128) &&
        (!('requestType' in data) || data.requestType in ['subscription', 'extra_types_addon']) &&
        (!('extraTypesCount' in data) || (data.extraTypesCount is int && data.extraTypesCount >= 0 && data.extraTypesCount <= 10)) &&
        (!('addonPriceJod' in data) || ((data.addonPriceJod is int || data.addonPriceJod is float) && data.addonPriceJod >= 0 && data.addonPriceJod <= 10000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'actorUid', 'actorEmail', 'action', 'targetTenantId', 'details', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'actorUid', 'actorEmail', 'action', 'targetTenantId', 'details',
          'beforeState', 'afterState', 'createdAt'
        ]) &&
        isValidId(data.actorUid) &&
        data.actorUid == request.auth.uid &&
        isValidString(data.actorEmail, 3, 200) &&
        isValidString(data.action, 1, 80) &&
        isValidString(data.targetTenantId, 0, 128) &&
        isValidString(data.details, 0, 500) &&
        (!('beforeState' in data) || isValidString(data.beforeState, 0, 600)) &&
        (!('afterState' in data) || isValidString(data.afterState, 0, 600)) &&
        data.createdAt is timestamp;
    }

    // ==================== CONNECTION PROBE ====================
    match /test/connection {
      allow get: if isSignedIn();
    }

    // ==================== DEFERRED / DISABLED COLLECTIONS (ZERO-COST SPARK STAGE) ====================
    // Additional admins, server webhooks, and auto-written expiry alerts are disabled on Spark.
    match /admins/{adminUid} {
      allow read, write: if false;
    }

    match /config_private/{configId} {
      allow read, write: if false;
    }

    match /expiry_alerts/{alertId} {
      allow read, write: if false;
    }

    // ==================== PUBLIC PLATFORM CONFIG (CliQ & WhatsApp ONLY) ====================
    match /config/{configId} {
      allow get: if isVerified() && isValidId(configId);
      allow list: if false;
      allow create: if isAdmin() && isValidId(configId) &&
        isValidPlatformConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(configId) &&
        isValidPlatformConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'whatsappPhone', 'cliqAlias', 'cliqBankName', 'cliqHolderName',
          'trialDaysDefault', 'supportNote', 'adminAlertEmail', 'expiryWebhookUrl',
          'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // ==================== SUBSCRIPTION PLANS ====================
    match /plans/{planId} {
      allow get: if isVerified() && isValidId(planId);
      allow list: if isVerified() && (resource.data.active == true || isOwnerAdmin());
      allow create: if isAdmin() && isValidId(planId) &&
        isValidPlan(incoming()) &&
        incoming().id == planId &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(planId) &&
        isValidPlan(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'priceLabel', 'priceMonthlyJod', 'maxProjects',
          'allowExport', 'allowCustomTypes', 'maxCustomTypes', 'maxCustomFieldsPerType',
          'allowExtraTypesAddon', 'extraTypesPackSize', 'extraTypesPackPriceJod',
          'active', 'sortOrder', 'features', 'updatedAt'
        ]);
      allow delete: if isOwnerAdmin() && isValidId(planId);
    }

    // ==================== TENANTS (VERIFIED EMAIL REQUIRED & SERVER-TIME TRIAL) ====================
    match /tenants/{tenantId} {
      allow get: if isVerified() && isValidId(tenantId) && (isTenantOwner(tenantId) || isAdmin());
      allow list: if isOwnerAdmin();

      // Self-registration: strictly requires verified email + server request.time + 7-day trial
      allow create: if isVerified() && isValidId(tenantId) &&
        isValidTenant(incoming(), tenantId) &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        !('activatedAt' in incoming()) &&
        !('subscriptionDays' in incoming()) &&
        tenantProjectCount(incoming()) == 0 &&
        tenantExtraTypesQuota(incoming()) == 0 &&
        (
          (
            isOwnerAdmin() &&
            incoming().ownerUid == request.auth.uid &&
            incoming().role == 'admin' &&
            incoming().subscriptionStatus == 'active' &&
            incoming().planId == 'owner_free' &&
            incoming().activeUntil == null
          ) ||
          (
            isTenantOwner(tenantId) &&
            incoming().role == 'owner' &&
            incoming().subscriptionStatus == 'trialing' &&
            incoming().planId == 'trial' &&
            incoming().trialDays == 7 &&
            incoming().activeUntil == null &&
            incoming().adminNote == ''
          )
        );

      // Action-Based Update: Admin Activation (Server-Time) vs Admin Non-Activation vs Tenant Actions
      allow update: if isVerified() && isValidId(tenantId) &&
        isValidTenant(incoming(), existing().ownerUid) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            // Branch A1: Owner Admin Subscription Activation / Renewal (STRICT SERVER TIME)
            // Requires activatedAt == request.time, subscriptionDays in [30, 90, 365], and activeUntil == null.
            isOwnerAdmin() &&
            incoming().role == existing().role &&
            incoming().subscriptionStatus == 'active' &&
            incoming().planId != 'trial' &&
            incoming().planId != 'owner_free' &&
            incoming().activatedAt == request.time &&
            isValidSubscriptionDays(incoming().subscriptionDays) &&
            incoming().activeUntil == null &&
            incoming().trialDays == existing().trialDays &&
            tenantProjectCount(incoming()) == tenantProjectCount(existing()) &&
            (
              tenantExtraTypesQuota(incoming()) == tenantExtraTypesQuota(existing()) ||
              tenantExtraTypesQuota(incoming()) == 0 ||
              adminExtraQuotaWithinCap(incoming())
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'subscriptionStatus', 'planId', 'activatedAt', 'subscriptionDays',
              'activeUntil', 'extraCustomTypesQuota', 'adminNote', 'updatedAt'
            ])
          ) ||
          (
            // Branch A2: Owner Admin Non-Activation Operations (Suspend, Reactivate unexpired, Extend Trial, Extra Quota, Profile)
            // Strictly forbids modifying activatedAt, subscriptionDays, activeUntil, or planId.
            isOwnerAdmin() &&
            incoming().role == existing().role &&
            incoming().planId == existing().planId &&
            activatedAtUnchanged(incoming(), existing()) &&
            subscriptionDaysUnchanged(incoming(), existing()) &&
            incoming().activeUntil == existing().activeUntil &&
            (
              incoming().subscriptionStatus != 'active' ||
              existing().subscriptionStatus == 'active' ||
              (
                existing().subscriptionStatus == 'suspended' &&
                hasValidPaidSubscription(existing())
              )
            ) &&
            (
              tenantExtraTypesQuota(incoming()) == tenantExtraTypesQuota(existing()) ||
              adminExtraQuotaWithinCap(incoming())
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopName', 'phone', 'displayName', 'subscriptionStatus',
              'trialDays', 'adminNote', 'projectCount', 'lastProjectActionId',
              'extraCustomTypesQuota', 'updatedAt'
            ])
          ) ||
          (
            // Tenant profile fields only
            isTenantOwner(tenantId) &&
            incoming().role == existing().role &&
            incoming().subscriptionStatus == existing().subscriptionStatus &&
            incoming().planId == existing().planId &&
            incoming().trialDays == existing().trialDays &&
            activatedAtUnchanged(incoming(), existing()) &&
            subscriptionDaysUnchanged(incoming(), existing()) &&
            incoming().activeUntil == existing().activeUntil &&
            incoming().adminNote == existing().adminNote &&
            tenantProjectCount(incoming()) == tenantProjectCount(existing()) &&
            tenantExtraTypesQuota(incoming()) == tenantExtraTypesQuota(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopName', 'phone', 'displayName', 'updatedAt'
            ])
          ) ||
          (
            // Tenant submitting CliQ payment request: only trialing/expired -> pending_payment (never grants access!)
            isTenantOwner(tenantId) &&
            existing().subscriptionStatus in ['trialing', 'expired'] &&
            incoming().subscriptionStatus == 'pending_payment' &&
            incoming().role == existing().role &&
            incoming().planId == existing().planId &&
            incoming().trialDays == existing().trialDays &&
            activatedAtUnchanged(incoming(), existing()) &&
            subscriptionDaysUnchanged(incoming(), existing()) &&
            incoming().activeUntil == existing().activeUntil &&
            incoming().adminNote == existing().adminNote &&
            tenantProjectCount(incoming()) == tenantProjectCount(existing()) &&
            tenantExtraTypesQuota(incoming()) == tenantExtraTypesQuota(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'subscriptionStatus', 'updatedAt'
            ])
          ) ||
          (
            // Atomic +1 projectCount increment coupled to creating a new project document in the same transaction
            isTenantOwner(tenantId) &&
            hasActiveTenantAccess(existing()) &&
            planAllowsNewProject(existing()) &&
            incoming().role == existing().role &&
            incoming().subscriptionStatus == existing().subscriptionStatus &&
            incoming().planId == existing().planId &&
            incoming().trialDays == existing().trialDays &&
            activatedAtUnchanged(incoming(), existing()) &&
            subscriptionDaysUnchanged(incoming(), existing()) &&
            incoming().activeUntil == existing().activeUntil &&
            incoming().adminNote == existing().adminNote &&
            tenantExtraTypesQuota(incoming()) == tenantExtraTypesQuota(existing()) &&
            incoming().projectCount == tenantProjectCount(existing()) + 1 &&
            isValidId(incoming().lastProjectActionId) &&
            !exists(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(incoming().lastProjectActionId)) &&
            existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(incoming().lastProjectActionId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'projectCount', 'lastProjectActionId', 'updatedAt'
            ])
          ) ||
          (
            // Atomic -1 projectCount decrement coupled to deleting an existing project document in the same transaction
            isTenantOwner(tenantId) &&
            hasActiveTenantAccess(existing()) &&
            tenantProjectCount(existing()) > 0 &&
            incoming().role == existing().role &&
            incoming().subscriptionStatus == existing().subscriptionStatus &&
            incoming().planId == existing().planId &&
            incoming().trialDays == existing().trialDays &&
            activatedAtUnchanged(incoming(), existing()) &&
            subscriptionDaysUnchanged(incoming(), existing()) &&
            incoming().activeUntil == existing().activeUntil &&
            incoming().adminNote == existing().adminNote &&
            tenantExtraTypesQuota(incoming()) == tenantExtraTypesQuota(existing()) &&
            incoming().projectCount == tenantProjectCount(existing()) - 1 &&
            isValidId(incoming().lastProjectActionId) &&
            exists(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(incoming().lastProjectActionId)) &&
            !existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(incoming().lastProjectActionId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'projectCount', 'lastProjectActionId', 'updatedAt'
            ])
          )
        );

      allow delete: if isOwnerAdmin() && isValidId(tenantId);

      // ==================== TENANT PROJECTS (MASTER GATE + FULL SERVER PLAN LIMITS) ====================
      match /projects/{projectId} {
        allow get: if isVerified() && isValidId(tenantId) && isValidId(projectId) &&
          (
            isAdmin() ||
            (
              isTenantOwner(tenantId) &&
              exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
              hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data)
            )
          );

        allow list: if isVerified() && (
          (
            request.auth.uid == tenantId &&
            resource.data.ownerUid == request.auth.uid &&
            exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
            hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data)
          ) ||
          isOwnerAdmin()
        );

        // Master Gate: verified email + active subscription/trial + maxProjects + maxCustomTypes + maxCustomFieldsPerType + atomic counter
        allow create: if isVerified() && isValidId(tenantId) && isValidId(projectId) &&
          isValidProject(incoming(), tenantId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              isTenantOwner(tenantId) &&
              exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
              hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data) &&
              planAllowsNewProject(get(/databases/$(database)/documents/tenants/$(tenantId)).data) &&
              planAllowsCustomTypes(get(/databases/$(database)/documents/tenants/$(tenantId)).data, incoming()) &&
              planAllowsCustomFields(get(/databases/$(database)/documents/tenants/$(tenantId)).data, incoming()) &&
              getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.projectCount ==
                tenantProjectCount(get(/databases/$(database)/documents/tenants/$(tenantId)).data) + 1
            )
          );

        allow update: if isVerified() && isValidId(tenantId) && isValidId(projectId) &&
          isValidProject(incoming(), existing().ownerUid) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'windowType', 'unit', 'windowCount', 'snapshot', 'updatedAt'
          ]) &&
          (
            isAdmin() ||
            (
              isTenantOwner(tenantId) &&
              exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
              hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data) &&
              planAllowsCustomTypes(get(/databases/$(database)/documents/tenants/$(tenantId)).data, incoming()) &&
              planAllowsCustomFields(get(/databases/$(database)/documents/tenants/$(tenantId)).data, incoming())
            )
          );

        allow delete: if isVerified() && isValidId(tenantId) && isValidId(projectId) &&
          (
            isAdmin() ||
            (
              isTenantOwner(tenantId) &&
              exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
              hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(tenantId)).data) &&
              (
                tenantProjectCount(get(/databases/$(database)/documents/tenants/$(tenantId)).data) == 0 ||
                getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.projectCount ==
                  tenantProjectCount(get(/databases/$(database)/documents/tenants/$(tenantId)).data) - 1
              )
            )
          );
      }
    }

    // ==================== ACTIVATION REQUESTS (CliQ / WhatsApp — NO DOUBLE APPROVAL) ====================
    match /activation_requests/{requestId} {
      allow get: if isVerified() && isValidId(requestId) &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow list: if isVerified() && (
        resource.data.ownerUid == request.auth.uid || isOwnerAdmin()
      );

      // Allowed even when trial/subscription is expired for regular subscription requests.
      // Extra-types add-on requests are strictly restricted to active tenants on the last plan!
      allow create: if isVerified() && isValidId(requestId) &&
        isValidActivationRequest(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().tenantId == request.auth.uid &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().status == 'pending' &&
        incoming().reviewedBy == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/tenants/$(request.auth.uid)) &&
        (
          !('requestType' in incoming()) ||
          incoming().requestType == 'subscription' ||
          (
            incoming().requestType == 'extra_types_addon' &&
            get(/databases/$(database)/documents/tenants/$(request.auth.uid)).data.subscriptionStatus == 'active' &&
            hasActiveTenantAccess(get(/databases/$(database)/documents/tenants/$(request.auth.uid)).data) &&
            exists(/databases/$(database)/documents/plans/$(get(/databases/$(database)/documents/tenants/$(request.auth.uid)).data.planId)) &&
            planAllowsExtraTypesAddon(get(/databases/$(database)/documents/plans/$(get(/databases/$(database)/documents/tenants/$(request.auth.uid)).data.planId)).data) &&
            planBaseMaxCustomTypes(get(/databases/$(database)/documents/plans/$(get(/databases/$(database)/documents/tenants/$(request.auth.uid)).data.planId)).data) >= 0 &&
            ('extraTypesCount' in incoming() && incoming().extraTypesCount is int && incoming().extraTypesCount >= 1) &&
            (
              planBaseMaxCustomTypes(get(/databases/$(database)/documents/plans/$(get(/databases/$(database)/documents/tenants/$(request.auth.uid)).data.planId)).data) +
              tenantExtraTypesQuota(get(/databases/$(database)/documents/tenants/$(request.auth.uid)).data) +
              incoming().extraTypesCount
            ) <= 10
          )
        );

      // Terminal State Locking: Owner Admin can ONLY approve/reject a 'pending' request (prevents double-approval!)
      allow update: if isVerified() && isValidId(requestId) &&
        isValidActivationRequest(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().tenantId == existing().tenantId &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            existing().status == 'pending' &&
            incoming().status in ['approved', 'rejected'] &&
            incoming().reviewedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt'])
          ) ||
          (
            existing().ownerUid == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().reviewedBy == existing().reviewedBy &&
            incoming().diff(existing()).affectedKeys().hasOnly(['cliqNote', 'phone', 'planId', 'billingCycle', 'updatedAt'])
          )
        );

      allow delete: if isOwnerAdmin() && isValidId(requestId);
    }

    // ==================== IMMUTABLE AUDIT LOGS ====================
    match /audit_logs/{logId} {
      allow get: if isOwnerAdmin() && isValidId(logId);
      allow list: if isOwnerAdmin();
      allow create: if isOwnerAdmin() && isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
