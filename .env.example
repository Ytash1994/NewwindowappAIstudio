# إعدادات Firebase App Check (مجاني تماماً ضمن خطة Spark — بدون Billing)
# ضع هنا مفتاح reCAPTCHA v3 العام فقط (Site Key) قبل تشغيل npm run build للإنتاج.
# تحذير أمان: لا تضع المفتاح السري (Secret Key) هنا أبداً — يُضاف المفتاح السري فقط داخل Firebase Console > App Check.
VITE_RECAPTCHA_V3_SITE_KEY=""

# للتجربة المحلية فقط أثناء التطوير (import.meta.env.DEV) — يُتجاهل تلقائياً في الإنتاج.
# استخدم "true" لطباعة Debug Token في المتصفح ثم سجّله في Firebase Console > App Check > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=""
